VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional. Absolute CDN/R2 base for the Godot web export (no trailing slash).
# Required in Cloudflare production because Workers rejects assets over 25 MiB
# (godot-shift/index.pck is ~253 MiB). Local dev can leave this blank to use /godot-shift.
# Example: https://pub-xxxxx.r2.dev/godot-shift
VITE_GODOT_SHIFT_BASE=
