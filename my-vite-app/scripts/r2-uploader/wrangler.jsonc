{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "bottlecaller-r2-uploader-temp",
  "main": "./worker.js",
  "compatibility_date": "2026-08-02",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "bottlecaller-godot"
    }
  ]
}
